# Copier ce fichier vers .env puis renseigner les secrets nécessaires.
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Obligatoire pour activer le diagnostic cloud ; sans clé, le statut reste A_VERIFIER.
GROQ_API_KEY=

# Chemins relatifs à la racine du projet.
KNOWLEDGE_BASE_PATH=data/knowledge_base/politique_support.yaml
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_TOP_K=3
RAG_SIMILARITY_THRESHOLD=0.45